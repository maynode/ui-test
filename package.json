{
  "name": "etcert-e2e",
  "version": "1.0.0",
  "description": "etcert training/certification platform Playwright E2E",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cross-env ENV=%ENV% playwright test",
    "test:single": "cross-env ENV=%ENV% playwright test Interactions.test.ts --project=Chrome",
    "test:parallel": "cross-env ENV=%ENV% playwright test --grep @Smoke --project=Chrome",
    "test:serial": "cross-env ENV=%ENV% playwright test --grep @Smoke --workers=1 --project=Chrome",
    "test:serial:ci": "playwright test --grep @Smoke --workers=1 --project=Chrome",
    "test:ui": "cross-env ENV=%ENV% playwright test --grep @Smoke --ui",
    "test:api": "cross-env ENV=%ENV% playwright test --grep @API --workers=1 --project=API",
    "test:db": "cross-env ENV=%ENV% playwright test DB.test.ts --project=DB",
    "test:record": "playwright codegen",
    "test:visual": "cross-env ENV=%ENV% playwright test visualComparision.test.ts --project=Chrome",
    "test:device": "cross-env ENV=%ENV% playwright test Emulation.test.ts --project=Device",
    "allureReport": "allure serve",
    "lighthouse": "node tests/lighthouse/Lighthouse.js",
    "test:accessibility": "cross-env ENV=%ENV% playwright test Axe.test.ts --project=Chrome",
    "test:main-flow": "playwright test --project=TC-MainFlow --grep @MainFlow --grep-invert @Destructive --workers=1",
    "test:main-flow:screenshots": "cross-env STEP_SCREENSHOT=1 playwright test --project=TC-MainFlow --grep @MainFlow --grep-invert @Destructive --workers=1",
    "test:main-flow:destructive": "playwright test --project=TC-MainFlow --grep \"(?=.*@MainFlow)(?=.*@Destructive)\" --workers=1",
    "test:main-flow:ci": "cross-env ENV=tcTest playwright test --project=TC-MainFlow --grep @MainFlow --grep-invert @Destructive --workers=1",
    "test:main-flow:tcTest": "cross-env ENV=tcTest playwright test --project=TC-MainFlow --grep @MainFlow --grep-invert @Destructive --workers=1",
    "test:main-flow:screenshots:tcTest": "cross-env ENV=tcTest STEP_SCREENSHOT=1 playwright test --project=TC-MainFlow --grep @MainFlow --grep-invert @Destructive --workers=1",
    "test:main-flow:destructive:tcTest": "cross-env ENV=tcTest playwright test --project=TC-MainFlow --grep \"(?=.*@MainFlow)(?=.*@Destructive)\" --workers=1",
    "test:tc-platform": "playwright test --project=TC-Platform --grep-invert @Destructive",
    "test:tc-platform:smoke": "playwright test --grep @Smoke --project=TC-Platform --workers=1",
    "test:tc-platform:destructive": "playwright test --grep @Destructive --project=TC-Platform --workers=1",
    "test:tc-platform:tcTest": "cross-env ENV=tcTest playwright test --project=TC-Platform --grep-invert @Destructive",
    "test:tc-platform:ci": "cross-env ENV=tcTest playwright test --grep @Smoke --project=TC-Platform --workers=1",
    "test:tc-platform:smoke:tcTest": "cross-env ENV=tcTest playwright test --grep @Smoke --project=TC-Platform --workers=1",
    "test:tc-admin:seed": "playwright test --project=TC-Admin --grep @Seed --workers=1",
    "test:tc-admin:seed:tcTest": "cross-env ENV=tcTest TC_SEED_CERT_QUERY=测试考试 playwright test --project=TC-Admin --grep @Seed --workers=1"
  },
  "repository": {
    "type": "git"
  },
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/crypto-js": "^4.2.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "allure-playwright": "^3.8.0",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "exceljs": "^4.4.0",
    "lighthouse": "^9.6.8",
    "ortoni-report": "^4.0.8",
    "pdfjs-dist-es5": "^2.13.216",
    "pg": "^8.21.0",
    "typescript": "^6.0.3",
    "winston": "^3.19.0"
  }
}
